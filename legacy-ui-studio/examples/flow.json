      "condition": "value",
      "value": "",
      "wait_seconds": 5
    },
    {
      "action": "set_value",
      "selector": "customer_code.json",
      "value": "KH-REPLAY-002"
    },
    {
      "action": "sleep",
      "seconds": 1
    },
    {
