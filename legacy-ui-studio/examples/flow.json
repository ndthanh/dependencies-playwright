      "poll_seconds": 0.2
    },
    {
      "action": "sleep",
      "seconds": 2
    },
    {
      "action": "invoke",
      "selector": "reset_button.json"
    },
    {
      "action": "wait",
      "selector": "customer_code.json",
      "condition": "value",
      "value": "",
      "wait_seconds": 5
    },
    {
      "action": "wait",
      "selector": "customer_name.json",
      "condition": "value",
      "value": "",
      "wait_seconds": 5
    }
